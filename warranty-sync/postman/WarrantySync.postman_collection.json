{
  "info": {
    "name": "Warranty Sync - Setup Lookups",
    "_postman_id": "6f0f3d8e-2a51-4b7c-9e1d-58c4b2a7d903",
    "description": "Looks up the values the Warranty Sync Power Automate solution needs. See README.md in this folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. IT Glue",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "x-api-key",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{itglue_api_key}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "description": "Finds the IDs for the Laptop and Desktop types and the Active status, then shows a sample device so you can read the myITProcess attribute name and the rmm-id / psa-id formats. Read-only.",
      "item": [
        {
          "name": "1.1 Configuration types (Laptop / Desktop IDs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json"
              }
            ],
            "url": {
              "raw": "{{itglue_host}}/configuration_types?page[size]=1000",
              "host": [
                "{{itglue_host}}"
              ],
              "path": [
                "configuration_types"
              ],
              "query": [
                {
                  "key": "page[size]",
                  "value": "1000"
                }
              ]
            },
            "description": "Sets `laptop_type_id` and `desktop_type_id` -> environment variables **IT Glue Laptop type ID** and **IT Glue Desktop type ID**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data.map(t => ({ id: t.id, name: t.attributes.name }));",
                  "console.table(rows);",
                  "const find = re => rows.find(r => re.test(r.name));",
                  "const laptop = find(/^laptops?$/i) || find(/laptop/i);",
                  "const desktop = find(/^desktops?$/i) || find(/desktop/i);",
                  "if (laptop) pm.environment.set(\"laptop_type_id\", laptop.id);",
                  "if (desktop) pm.environment.set(\"desktop_type_id\", desktop.id);",
                  "pm.test(\"Laptop type found: \" + (laptop ? laptop.name + \" = \" + laptop.id : \"NONE - pick from the console\"), () => pm.expect(laptop).to.exist);",
                  "pm.test(\"Desktop type found: \" + (desktop ? desktop.name + \" = \" + desktop.id : \"NONE - pick from the console\"), () => pm.expect(desktop).to.exist);",
                  "pm.visualizer.set(`<table border=1 cellpadding=4><tr><th>ID</th><th>Name</th></tr>{{#each rows}}<tr><td>{{id}}</td><td>{{name}}</td></tr>{{/each}}</table>`, { rows });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Configuration statuses (Active ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json"
              }
            ],
            "url": {
              "raw": "{{itglue_host}}/configuration_statuses?page[size]=1000",
              "host": [
                "{{itglue_host}}"
              ],
              "path": [
                "configuration_statuses"
              ],
              "query": [
                {
                  "key": "page[size]",
                  "value": "1000"
                }
              ]
            },
            "description": "Sets `active_status_id` -> environment variable **IT Glue Active status ID**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data.map(t => ({ id: t.id, name: t.attributes.name }));",
                  "console.table(rows);",
                  "const active = rows.find(r => /^active$/i.test(r.name)) || rows.find(r => /active/i.test(r.name));",
                  "if (active) pm.environment.set(\"active_status_id\", active.id);",
                  "pm.test(\"Active status found: \" + (active ? active.name + \" = \" + active.id : \"NONE - pick from the console\"), () => pm.expect(active).to.exist);",
                  "pm.visualizer.set(`<table border=1 cellpadding=4><tr><th>ID</th><th>Name</th></tr>{{#each rows}}<tr><td>{{id}}</td><td>{{name}}</td></tr>{{/each}}</table>`, { rows });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Sample laptops (myITProcess attribute, rmm-id, psa-id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json"
              }
            ],
            "url": {
              "raw": "{{itglue_host}}/configurations?filter[configuration_type_id]={{laptop_type_id}}&filter[configuration_status_id]={{active_status_id}}&filter[archived]=false&page[size]=25",
              "host": [
                "{{itglue_host}}"
              ],
              "path": [
                "configurations"
              ],
              "query": [
                {
                  "key": "filter[configuration_type_id]",
                  "value": "{{laptop_type_id}}"
                },
                {
                  "key": "filter[configuration_status_id]",
                  "value": "{{active_status_id}}"
                },
                {
                  "key": "filter[archived]",
                  "value": "false"
                },
                {
                  "key": "page[size]",
                  "value": "25"
                }
              ]
            },
            "description": "Lists 25 active laptops and shows every **date / warranty** attribute with sample values, so you can pick the exact myITProcess attribute name -> environment variable **myITProcess attribute name**. Also reports whether `rmm-id` looks like a Datto device UID (GUID) or a number, and saves the first device's IDs for the next requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"Devices returned: \" + data.length, () => pm.expect(data.length).to.be.above(0));",
                  "const guid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  "const dateLike = v => typeof v === \"string\" && /^\\d{4}-\\d{2}-\\d{2}/.test(v);",
                  "// every attribute that is warranty/date-ish, with how many devices have a value and a sample",
                  "const stats = {};",
                  "data.forEach(d => Object.entries(d.attributes).forEach(([k, v]) => {",
                  "  if (/warrant|expir|myit|purchase|install/i.test(k) || dateLike(v)) {",
                  "    stats[k] = stats[k] || { attribute: k, filled: 0, sample: \"\" };",
                  "    if (v !== null && v !== \"\") { stats[k].filled++; if (!stats[k].sample) stats[k].sample = String(v); }",
                  "  }",
                  "}));",
                  "const attrs = Object.values(stats).sort((a, b) => b.filled - a.filled);",
                  "console.table(attrs);",
                  "const rows = data.map(d => ({ id: d.id, org: d.attributes[\"organization-name\"], name: d.attributes.name,",
                  "  serial: d.attributes[\"serial-number\"], rmm: d.attributes[\"rmm-id\"], psa: d.attributes[\"psa-id\"],",
                  "  rmmFormat: d.attributes[\"rmm-id\"] == null ? \"missing\" : guid.test(String(d.attributes[\"rmm-id\"])) ? \"GUID (device UID)\" : \"number / other\",",
                  "  glue: d.attributes[\"warranty-expires-at\"] }));",
                  "console.table(rows);",
                  "const first = data.find(d => d.attributes[\"rmm-id\"] && d.attributes[\"psa-id\"]) || data[0];",
                  "if (first) {",
                  "  pm.environment.set(\"configuration_id\", first.id);",
                  "  pm.environment.set(\"rmm_id\", first.attributes[\"rmm-id\"] || \"\");",
                  "  pm.environment.set(\"psa_id\", first.attributes[\"psa-id\"] || \"\");",
                  "}",
                  "const rmmGuid = rows.filter(r => r.rmmFormat.startsWith(\"GUID\")).length;",
                  "pm.test(`rmm-id is a GUID on ${rmmGuid}/${rows.length} devices (GUID = Datto device UID, no extra lookup needed)`, () => true);",
                  "pm.visualizer.set(`",
                  "<h3>Date / warranty attributes (pick the myITProcess one)</h3>",
                  "<table border=1 cellpadding=4><tr><th>Attribute</th><th>Devices with a value</th><th>Sample</th></tr>",
                  "{{#each attrs}}<tr><td><b>{{attribute}}</b></td><td>{{filled}}</td><td>{{sample}}</td></tr>{{/each}}</table>",
                  "<h3>Devices</h3>",
                  "<table border=1 cellpadding=4><tr><th>ID</th><th>Org</th><th>Name</th><th>Serial</th><th>rmm-id</th><th>Format</th><th>psa-id</th><th>IT Glue warranty</th></tr>",
                  "{{#each rows}}<tr><td>{{id}}</td><td>{{org}}</td><td>{{name}}</td><td>{{serial}}</td><td>{{rmm}}</td><td>{{rmmFormat}}</td><td>{{psa}}</td><td>{{glue}}</td></tr>{{/each}}</table>`,",
                  "  { attrs, rows });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 One configuration (full attributes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json"
              }
            ],
            "url": {
              "raw": "{{itglue_host}}/configurations/{{configuration_id}}",
              "host": [
                "{{itglue_host}}"
              ],
              "path": [
                "configurations",
                "{{configuration_id}}"
              ]
            },
            "description": "Full record for `configuration_id` (set by 1.3, or type your own). Use it to double-check the myITProcess attribute name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json().data.attributes;",
                  "console.log(JSON.stringify(a, null, 2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Datto RMM",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{datto_token}}",
            "type": "string"
          }
        ]
      },
      "description": "Gets a token, confirms the connector's token method works, and checks that IT Glue's rmm-id is a Datto device UID. Read-only.",
      "item": [
        {
          "name": "2.1 Get token (form body - Datto standard)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{datto_api_url}}/auth/oauth/token",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "auth",
                "oauth",
                "token"
              ]
            },
            "description": "Standard Datto RMM token request. Sets `datto_token` for the other requests.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{datto_api_key}}"
                },
                {
                  "key": "password",
                  "value": "{{datto_api_secret}}"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "public-client",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "public",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.test(\"access_token returned\", () => pm.expect(t).to.be.a(\"string\"));",
                  "pm.environment.set(\"datto_token\", t);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Get token (query parameters - as the custom connector does)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{datto_api_url}}/auth/oauth/token?grant_type=password&username={{datto_api_key}}&password={{datto_api_secret}}",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "auth",
                "oauth",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{datto_api_key}}"
                },
                {
                  "key": "password",
                  "value": "{{datto_api_secret}}"
                }
              ]
            },
            "description": "**Important.** The Datto RMM (Warranty Sync) connector sends the key and secret as query parameters, because a custom connector can't build a form body from its connection. If this request returns a token, the connector will work. If 2.1 works but this fails, tell Claude so the connector can be changed.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "public-client",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "public",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Connector token method works (200 + access_token)\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().access_token).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Account (confirms platform URL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{datto_api_url}}/api/v2/account",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "api",
                "v2",
                "account"
              ]
            },
            "description": "If this works, `datto_api_url` is right. The platform name for the connector connection is the part before `-api`, e.g. `https://merlot-api.centrastage.net` -> `merlot`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const host = pm.environment.replaceIn(\"{{datto_api_url}}\").match(/https?:\\/\\/([^.-]+)-api/);",
                  "pm.test(\"Connector platform value: \" + (host ? host[1] : \"?\"), () => pm.expect(host).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Device by UID (is rmm-id a device UID?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{datto_api_url}}/api/v2/device/{{rmm_id}}",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "api",
                "v2",
                "device",
                "{{rmm_id}}"
              ]
            },
            "description": "Uses `rmm_id` from 1.3. **200** means rmm-id is the Datto device UID, so the flow can write warranties directly. **404** means it isn't; run 2.5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rmm-id is a Datto device UID (200)\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  console.log({ hostname: d.hostname, uid: d.uid, id: d.id, warrantyDate: d.warrantyDate, site: d.siteName });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Device by numeric ID (only if 2.4 fails)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{datto_api_url}}/api/v2/device/id/{{rmm_id}}",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "api",
                "v2",
                "device",
                "id",
                "{{rmm_id}}"
              ]
            },
            "description": "If rmm-id is numeric, this finds the device and shows its `uid`. In that case the flow needs an extra lookup step; tell Claude."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) console.log(\"Numeric ID resolves to uid:\", pm.response.json().uid);",
                  "pm.test(\"Status \" + pm.response.code, () => true);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Request rate (API limit headroom)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{datto_api_url}}/api/v2/system/request_rate",
              "host": [
                "{{datto_api_url}}"
              ],
              "path": [
                "api",
                "v2",
                "system",
                "request_rate"
              ]
            },
            "description": "Shows how much of Datto RMM's API request limit your account is using. Check it before the first big backfill: the Datto RMM Only flow makes up to two calls per device (read, then write if different). If usage is already high, lower **Max writes per run**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "console.log(r);",
                  "const rows = Object.entries(r).map(([k, v]) => ({ field: k, value: typeof v === \"object\" ? JSON.stringify(v) : String(v) }));",
                  "pm.visualizer.set(`<table border=1 cellpadding=4><tr><th>Field</th><th>Value</th></tr>{{#each rows}}<tr><td>{{field}}</td><td>{{value}}</td></tr>{{/each}}</table>`, { rows });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Autotask",
      "description": "Finds your Autotask zone (the connector is built for webservices4) and checks a configuration item's warranty field. Read-only.",
      "item": [
        {
          "name": "3.1 Zone information",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://webservices.autotask.net/atservicesrest/v1.0/zoneInformation?user={{autotask_username}}",
              "host": [
                "https:"
              ],
              "path": [
                "webservices.autotask.net",
                "atservicesrest",
                "v1.0",
                "zoneInformation"
              ],
              "query": [
                {
                  "key": "user",
                  "value": "{{autotask_username}}"
                }
              ]
            },
            "description": "Returns your zone URL and sets `autotask_base`. The Autotask (Warranty Sync) connector is built for **webservices4**; if yours differs, tell Claude."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const z = pm.response.json();",
                  "const base = z.url.replace(/\\/+$/, \"\") + \"/v1.0\";",
                  "pm.environment.set(\"autotask_base\", base);",
                  "pm.test(\"Zone: \" + z.url, () => true);",
                  "pm.test(\"Matches connector zone webservices4\", () => pm.expect(z.url.toLowerCase()).to.include(\"webservices4\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Configuration item (psa-id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "ApiIntegrationcode",
                "value": "{{autotask_integration_code}}"
              },
              {
                "key": "UserName",
                "value": "{{autotask_username}}"
              },
              {
                "key": "Secret",
                "value": "{{autotask_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{autotask_base}}/ConfigurationItems/{{psa_id}}",
              "host": [
                "{{autotask_base}}"
              ],
              "path": [
                "ConfigurationItems",
                "{{psa_id}}"
              ]
            },
            "description": "Uses `psa_id` from 1.3. Confirms IT Glue's psa-id is the Autotask configuration item ID and shows the current `warrantyExpirationDate`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"psa-id is an Autotask configuration item (200)\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const i = pm.response.json().item;",
                  "  console.log({ id: i.id, referenceTitle: i.referenceTitle, serialNumber: i.serialNumber, warrantyExpirationDate: i.warrantyExpirationDate });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Optional write tests (CHANGES DATA)",
      "description": "Plan step 1: write a warranty date to ONE test device and check it sticks. These requests change data. Set `test_warranty_date` (yyyy-MM-dd) first.",
      "item": [
        {
          "name": "4.1 IT Glue - set warranty on configuration_id",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/vnd.api+json"
              },
              {
                "key": "Accept",
                "value": "application/vnd.api+json"
              }
            ],
            "url": {
              "raw": "{{itglue_host}}/configurations/{{configuration_id}}",
              "host": [
                "{{itglue_host}}"
              ],
              "path": [
                "configurations",
                "{{configuration_id}}"
              ]
            },
            "description": "After this, wait for the next Autotask -> IT Glue sync and re-run 1.4. If the date has been overwritten or the request is refused, the Autotask field lock risk in the plan applies.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"type\": \"configurations\",\n    \"attributes\": {\n      \"warranty-expires-at\": \"{{test_warranty_date}}\"\n    }\n  }\n}"
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{itglue_api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
