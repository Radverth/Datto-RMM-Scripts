{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_wsync"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_new-5fwsitglue-5f7e14506b88214820": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_shared5fwsitglue5f7e14506b88214820_wsync"
        },
        "api": {
          "name": "shared_new-5fwsitglue-5f7e14506b88214820",
          "logicalName": "new_5Fwsitglue"
        }
      },
      "shared_new-5fwsautotask-5f7e14506b88214820": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_shared5fwsautotask5f7e14506b88214820_wsync"
        },
        "api": {
          "name": "shared_new-5fwsautotask-5f7e14506b88214820",
          "logicalName": "new_5Fwsautotask"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Dry run (new_DryRun)": {
          "defaultValue": true,
          "type": "Bool",
          "metadata": {
            "schemaName": "new_DryRun"
          }
        },
        "IT Glue Laptop type ID (new_LaptopTypeId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "new_LaptopTypeId"
          }
        },
        "IT Glue Desktop type ID (new_DesktopTypeId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "new_DesktopTypeId"
          }
        },
        "IT Glue Active status ID (new_ActiveStatusId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "new_ActiveStatusId"
          }
        },
        "myITProcess attribute name (new_MyITPAttribute)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "new_MyITPAttribute"
          }
        },
        "Max writes per run (new_MaxWritesPerRun)": {
          "defaultValue": "1500",
          "type": "String",
          "metadata": {
            "schemaName": "new_MaxWritesPerRun"
          }
        },
        "Summary email recipient (new_NotifyEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "new_NotifyEmail"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "required": [],
              "properties": {
                "Device": {
                  "title": "Device (blank = all)",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "IT Glue configuration ID, serial number, asset tag or device name. Leave blank for all devices.",
                  "x-ms-content-hint": "TEXT"
                },
                "WriteNow": {
                  "title": "Write now (ignore Dry run)",
                  "type": "boolean",
                  "x-ms-dynamically-added": true,
                  "description": "Yes = write to Autotask on this run even while the Dry run variable is Yes.",
                  "x-ms-content-hint": "BOOLEAN"
                }
              }
            }
          }
        }
      },
      "actions": {
        "Init_Devices": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Devices",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {}
        },
        "Init_Page": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Page",
                "type": "integer",
                "value": 1
              }
            ]
          },
          "runAfter": {
            "Init_Devices": [
              "Succeeded"
            ]
          }
        },
        "Init_PageCount": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "PageCount",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_Page": [
              "Succeeded"
            ]
          }
        },
        "Init_Results": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Results",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Init_PageCount": [
              "Succeeded"
            ]
          }
        },
        "Compose_Device": {
          "type": "Compose",
          "inputs": "@toLower(trim(string(coalesce(triggerBody()?['Device'], ''))))",
          "runAfter": {
            "Init_Results": [
              "Succeeded"
            ]
          }
        },
        "Compose_TypeIds": {
          "type": "Compose",
          "inputs": "@createArray(parameters('IT Glue Laptop type ID (new_LaptopTypeId)'), parameters('IT Glue Desktop type ID (new_DesktopTypeId)'))",
          "runAfter": {
            "Compose_Device": [
              "Succeeded"
            ]
          }
        },
        "If_device_entered": {
          "type": "If",
          "expression": {
            "equals": [
              "@not(empty(outputs('Compose_Device')))",
              true
            ]
          },
          "actions": {
            "Get_by_id": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_new-5fwsitglue-5f7e14506b88214820",
                  "operationId": "GetConfiguration",
                  "connectionName": "shared_new-5fwsitglue-5f7e14506b88214820"
                },
                "parameters": {
                  "id": "@{trim(string(triggerBody()?['Device']))}"
                }
              },
              "runAfter": {}
            },
            "Keep_if_laptop_desktop": {
              "type": "Query",
              "runAfter": {
                "Get_by_id": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@createArray(body('Get_by_id')?['data'])",
                "where": "@and(contains(createArray(string(parameters('IT Glue Laptop type ID (new_LaptopTypeId)')), string(parameters('IT Glue Desktop type ID (new_DesktopTypeId)'))), string(item()?['attributes']?['configuration-type-id'])), equals(string(item()?['attributes']?['configuration-status-id']), string(parameters('IT Glue Active status ID (new_ActiveStatusId)'))), not(equals(item()?['attributes']?['archived'], true)))"
              }
            },
            "Select_Found": {
              "type": "Select",
              "runAfter": {
                "Keep_if_laptop_desktop": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Keep_if_laptop_desktop')",
                "select": {
                  "id": "@item()?['id']",
                  "org": "@item()?['attributes']?['organization-name']",
                  "name": "@item()?['attributes']?['name']",
                  "serial": "@item()?['attributes']?['serial-number']",
                  "asset": "@string(coalesce(item()?['attributes']?['asset-tag'], ''))",
                  "glue": "@take(string(coalesce(item()?['attributes']?['warranty-expires-at'], '')), 10)",
                  "mitp": "@take(string(coalesce(item()?['attributes']?[parameters('myITProcess attribute name (new_MyITPAttribute)')], '')), 10)"
                }
              }
            },
            "Set_Found": {
              "type": "SetVariable",
              "runAfter": {
                "Select_Found": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "Devices",
                "value": "@body('Select_Found')"
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Compose_TypeIds": [
              "Succeeded"
            ]
          }
        },
        "Foreach_Type": {
          "type": "Foreach",
          "foreach": "@outputs('Compose_TypeIds')",
          "actions": {
            "Reset_Page": {
              "type": "SetVariable",
              "inputs": {
                "name": "Page",
                "value": 1
              },
              "runAfter": {}
            },
            "If_still_searching": {
              "type": "If",
              "expression": {
                "equals": [
                  "@not(and(not(empty(outputs('Compose_Device'))), greater(length(variables('Devices')), 0)))",
                  true
                ]
              },
              "actions": {
                "Page_until_short": {
                  "type": "Until",
                  "limit": {
                    "count": 100,
                    "timeout": "PT3H"
                  },
                  "actions": {
                    "Get_IT_Glue_page": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_new-5fwsitglue-5f7e14506b88214820",
                          "operationId": "ListConfigurations",
                          "connectionName": "shared_new-5fwsitglue-5f7e14506b88214820"
                        },
                        "parameters": {
                          "typeId": "@{items('Foreach_Type')}",
                          "statusId": "@{parameters('IT Glue Active status ID (new_ActiveStatusId)')}",
                          "pageSize": "1000",
                          "pageNumber": "@{variables('Page')}"
                        }
                      },
                      "runAfter": {}
                    },
                    "Select_Clean": {
                      "type": "Select",
                      "inputs": {
                        "from": "@body('Get_IT_Glue_page')?['data']",
                        "select": {
                          "id": "@item()?['id']",
                          "org": "@item()?['attributes']?['organization-name']",
                          "name": "@item()?['attributes']?['name']",
                          "serial": "@item()?['attributes']?['serial-number']",
                          "asset": "@string(coalesce(item()?['attributes']?['asset-tag'], ''))",
                          "glue": "@take(string(coalesce(item()?['attributes']?['warranty-expires-at'], '')), 10)",
                          "mitp": "@take(string(coalesce(item()?['attributes']?[parameters('myITProcess attribute name (new_MyITPAttribute)')], '')), 10)"
                        }
                      },
                      "runAfter": {
                        "Get_IT_Glue_page": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Set_PageCount": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "PageCount",
                        "value": "@length(body('Get_IT_Glue_page')?['data'])"
                      },
                      "runAfter": {
                        "Select_Clean": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Compose_Merged": {
                      "type": "Compose",
                      "inputs": "@union(variables('Devices'), body('Filter_Page'))",
                      "runAfter": {
                        "Filter_Page": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Merge_Devices": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Devices",
                        "value": "@outputs('Compose_Merged')"
                      },
                      "runAfter": {
                        "Compose_Merged": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Next_page": {
                      "type": "IncrementVariable",
                      "inputs": {
                        "name": "Page",
                        "value": 1
                      },
                      "runAfter": {
                        "Merge_Devices": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Filter_Page": {
                      "type": "Query",
                      "runAfter": {
                        "Set_PageCount": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "from": "@body('Select_Clean')",
                        "where": "@and(or(empty(outputs('Compose_Device')), equals(toLower(string(item()?['id'])), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['serial'], '')))), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['asset'], '')))), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['name'], '')))), outputs('Compose_Device'))), not(empty(trim(string(coalesce(item()?['serial'], ''))))))"
                      }
                    }
                  },
                  "expression": "@or(less(variables('PageCount'), 1000), and(not(empty(outputs('Compose_Device'))), greater(length(variables('Devices')), 0)))",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Reset_Page": [
                  "Succeeded"
                ]
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {
            "If_device_entered": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Select_Decided": {
          "type": "Select",
          "inputs": {
            "from": "@variables('Devices')",
            "select": {
              "id": "@item()?['id']",
              "org": "@item()?['org']",
              "name": "@item()?['name']",
              "serial": "@item()?['serial']",
              "asset": "@item()?['asset']",
              "glue": "@item()?['glue']",
              "mitp": "@item()?['mitp']",
              "target": "@if(empty(item()?['mitp']), item()?['glue'], if(or(empty(item()?['glue']), less(item()?['glue'], item()?['mitp'])), item()?['mitp'], item()?['glue']))",
              "later": "@and(not(empty(item()?['mitp'])), greater(item()?['glue'], item()?['mitp']))"
            }
          },
          "runAfter": {
            "Foreach_Type": [
              "Succeeded"
            ]
          }
        },
        "Filter_Target": {
          "type": "Query",
          "inputs": {
            "from": "@body('Select_Decided')",
            "where": "@or(empty(outputs('Compose_Device')), equals(toLower(string(item()?['id'])), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['serial'], '')))), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['asset'], '')))), outputs('Compose_Device')), equals(toLower(trim(string(coalesce(item()?['name'], '')))), outputs('Compose_Device')))"
          },
          "runAfter": {
            "Select_Decided": [
              "Succeeded"
            ]
          }
        },
        "Filter_System": {
          "type": "Query",
          "inputs": {
            "from": "@body('Filter_Target')",
            "where": "@and(not(empty(item()?['target'])), not(empty(trim(string(coalesce(item()?['serial'], ''))))))"
          },
          "runAfter": {
            "Filter_Target": [
              "Succeeded"
            ]
          }
        },
        "Compose_Batch": {
          "type": "Compose",
          "inputs": "@take(body('Filter_System'), int(parameters('Max writes per run (new_MaxWritesPerRun)')))",
          "runAfter": {
            "Filter_System": [
              "Succeeded"
            ]
          }
        },
        "Foreach_Device": {
          "type": "Foreach",
          "foreach": "@outputs('Compose_Batch')",
          "actions": {
            "Find_CI": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_new-5fwsautotask-5f7e14506b88214820",
                  "operationId": "QueryConfigurationItems",
                  "connectionName": "shared_new-5fwsautotask-5f7e14506b88214820"
                },
                "parameters": {
                  "body": {
                    "MaxRecords": 10,
                    "IncludeFields": [
                      "id",
                      "serialNumber",
                      "isActive",
                      "rmmDeviceUID",
                      "referenceTitle",
                      "warrantyExpirationDate"
                    ],
                    "Filter": [
                      {
                        "op": "eq",
                        "field": "serialNumber",
                        "value": "@{if(empty(trim(string(coalesce(items('Foreach_Device')?['serial'], '')))), '-no-serial-', trim(string(coalesce(items('Foreach_Device')?['serial'], ''))))}"
                      }
                    ]
                  }
                }
              },
              "runAfter": {}
            },
            "Filter_CI_active": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(body('Find_CI')?['items'], createArray())",
                "where": "@equals(item()?['isActive'], true)"
              },
              "runAfter": {
                "Find_CI": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "Compose_CICount": {
              "type": "Compose",
              "inputs": "@length(body('Filter_CI_active'))",
              "runAfter": {
                "Filter_CI_active": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "Compose_CI": {
              "type": "Compose",
              "inputs": "@if(equals(outputs('Compose_CICount'), 1), first(body('Filter_CI_active')), json('{}'))",
              "runAfter": {
                "Compose_CICount": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "Compose_Psa": {
              "type": "Compose",
              "inputs": "@string(coalesce(outputs('Compose_CI')?['id'], ''))",
              "runAfter": {
                "Compose_CI": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "Compose_Rmm": {
              "type": "Compose",
              "inputs": "@if(not(empty(string(coalesce(outputs('Compose_CI')?['rmmDeviceUID'], '')))), string(outputs('Compose_CI')?['rmmDeviceUID']), if(and(equals(length(trim(string(coalesce(items('Foreach_Device')?['asset'], '')))), 36), equals(length(split(trim(string(coalesce(items('Foreach_Device')?['asset'], ''))), '-')), 5)), trim(string(coalesce(items('Foreach_Device')?['asset'], ''))), ''))",
              "runAfter": {
                "Compose_Psa": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "If_has_id": {
              "type": "If",
              "runAfter": {
                "Compose_Rmm": [
                  "Succeeded"
                ]
              },
              "expression": {
                "equals": [
                  "@not(empty(outputs('Compose_Psa')))",
                  true
                ]
              },
              "actions": {
                "Compose_Current": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@take(string(coalesce(outputs('Compose_CI')?['warrantyExpirationDate'], '')), 10)"
                },
                "If_differs": {
                  "type": "If",
                  "runAfter": {
                    "Compose_Current": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "equals": [
                      "@not(equals(outputs('Compose_Current'), items('Foreach_Device')?['target']))",
                      true
                    ]
                  },
                  "actions": {
                    "Scope_Write": {
                      "type": "Scope",
                      "runAfter": {},
                      "actions": {
                        "If_live_write": {
                          "type": "If",
                          "expression": {
                            "equals": [
                              "@or(contains(createArray('false', 'no'), toLower(string(parameters('Dry run (new_DryRun)')))), equals(triggerBody()?['WriteNow'], true))",
                              true
                            ]
                          },
                          "actions": {
                            "Write_warranty": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_new-5fwsautotask-5f7e14506b88214820",
                                  "operationId": "UpdateConfigurationItem",
                                  "connectionName": "shared_new-5fwsautotask-5f7e14506b88214820"
                                },
                                "parameters": {
                                  "body/id": "@int(outputs('Compose_Psa'))",
                                  "body/warrantyExpirationDate": "@{items('Foreach_Device')?['target']}T00:00:00Z"
                                }
                              },
                              "runAfter": {}
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "runAfter": {}
                        }
                      }
                    },
                    "Record_change": {
                      "type": "AppendToArrayVariable",
                      "runAfter": {
                        "Scope_Write": [
                          "Succeeded",
                          "Failed",
                          "Skipped",
                          "TimedOut"
                        ]
                      },
                      "inputs": {
                        "name": "Results",
                        "value": {
                          "org": "@items('Foreach_Device')?['org']",
                          "device": "@items('Foreach_Device')?['name']",
                          "serial": "@items('Foreach_Device')?['serial']",
                          "AutotaskID": "@outputs('Compose_Psa')",
                          "Autotask": "@outputs('Compose_Current')",
                          "target": "@items('Foreach_Device')?['target']",
                          "result": "@if(equals(actions('Scope_Write')?['status'], 'Failed'), 'Error', if(or(contains(createArray('false', 'no'), toLower(string(parameters('Dry run (new_DryRun)')))), equals(triggerBody()?['WriteNow'], true)), 'Updated', 'Would update'))"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "If_targeted": {
                        "type": "If",
                        "expression": {
                          "equals": [
                            "@not(empty(outputs('Compose_Device')))",
                            true
                          ]
                        },
                        "actions": {
                          "Record_unchanged": {
                            "type": "AppendToArrayVariable",
                            "runAfter": {},
                            "inputs": {
                              "name": "Results",
                              "value": {
                                "org": "@items('Foreach_Device')?['org']",
                                "device": "@items('Foreach_Device')?['name']",
                                "serial": "@items('Foreach_Device')?['serial']",
                                "AutotaskID": "@outputs('Compose_Psa')",
                                "Autotask": "@outputs('Compose_Current')",
                                "target": "@items('Foreach_Device')?['target']",
                                "result": "Already correct"
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        },
                        "runAfter": {}
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Record_no_match": {
                    "type": "AppendToArrayVariable",
                    "runAfter": {},
                    "inputs": {
                      "name": "Results",
                      "value": {
                        "org": "@items('Foreach_Device')?['org']",
                        "device": "@items('Foreach_Device')?['name']",
                        "serial": "@items('Foreach_Device')?['serial']",
                        "AutotaskID": "@outputs('Compose_Psa')",
                        "Autotask": "",
                        "target": "@items('Foreach_Device')?['target']",
                        "result": "@trim(if(greater(outputs('Compose_CICount'), 1), 'Several active Autotask items share this serial. ', 'No active Autotask item with this serial. '))"
                      }
                    }
                  }
                }
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {
            "Compose_Batch": [
              "Succeeded"
            ]
          }
        },
        "Filter_Changed": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@contains(createArray('Updated', 'Would update'), item()?['result'])"
          },
          "runAfter": {
            "Foreach_Device": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Filter_Failed": {
          "type": "Query",
          "inputs": {
            "from": "@variables('Results')",
            "where": "@not(contains(createArray('Updated', 'Would update', 'Already correct'), item()?['result']))"
          },
          "runAfter": {
            "Filter_Changed": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Results_table": {
          "type": "Table",
          "inputs": {
            "from": "@variables('Results')",
            "format": "HTML"
          },
          "runAfter": {
            "Filter_Failed": [
              "Succeeded",
              "Failed",
              "Skipped",
